{
  "schemaVersion": 1,
  "sourceSchemaVersion": 3,
  "description": "Representative task-v3 sources the future v3->v4 migrator must handle. Each fixture is valid per src/tasks/source-v3.ts (parseTaskV3Yaml succeeds) and isolates one authoring dimension: a trigger form, a target form, or the env/timeout/redact option bundle.",
  "fixtures": [
    {
      "id": "trigger-akm-schedule",
      "file": "trigger-akm-schedule.yml",
      "represents": ["trigger:akm-schedule"],
      "expected": {
        "triggers": { "manual": false, "schedules": [{ "cron": "0 6 * * *", "source": "akm.schedule", "ordinal": 0 }] },
        "target": { "kind": "uses", "usesKind": "command", "ref": "commands/release-notes" }
      }
    },
    {
      "id": "trigger-on-schedule",
      "file": "trigger-on-schedule.yml",
      "represents": ["trigger:on-schedule"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "30 9 * * 2", "source": "on.schedule[0].cron", "ordinal": 0 }]
        },
        "target": { "kind": "uses", "usesKind": "command", "ref": "commands/release-notes" }
      }
    },
    {
      "id": "trigger-on-workflow-dispatch-manual",
      "file": "trigger-on-workflow-dispatch-manual.yml",
      "represents": ["trigger:on-workflow-dispatch-manual"],
      "expected": {
        "triggers": { "manual": true, "schedules": [] },
        "target": { "kind": "uses", "usesKind": "command", "ref": "commands/release-notes" }
      }
    },
    {
      "id": "target-command",
      "file": "target-command.yml",
      "represents": ["target:command"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "15 4 * * 1", "source": "akm.schedule", "ordinal": 0 }]
        },
        "target": { "kind": "uses", "usesKind": "command", "ref": "commands/publish-changelog" }
      }
    },
    {
      "id": "target-run-shell",
      "file": "target-run-shell.yml",
      "represents": ["target:run-shell"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "15 4 * * 1", "source": "akm.schedule", "ordinal": 0 }]
        },
        "target": { "kind": "run", "run": "akm index --full", "shell": "bash" }
      }
    },
    {
      "id": "target-script",
      "file": "target-script.yml",
      "represents": ["target:script"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "15 4 * * 1", "source": "akm.schedule", "ordinal": 0 }]
        },
        "target": { "kind": "uses", "usesKind": "script", "ref": "scripts/nightly-cleanup.sh" }
      }
    },
    {
      "id": "target-workflow",
      "file": "target-workflow.yml",
      "represents": ["target:workflow"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "15 4 * * 1", "source": "akm.schedule", "ordinal": 0 }]
        },
        "target": {
          "kind": "uses",
          "usesKind": "workflow",
          "ref": "workflows/nightly-report",
          "with": { "channel": "release" }
        }
      }
    },
    {
      "id": "options-env-timeout-redact",
      "file": "options-env-timeout-redact.yml",
      "represents": ["options:env-timeout-redact"],
      "expected": {
        "triggers": {
          "manual": false,
          "schedules": [{ "cron": "15 4 * * 1", "source": "akm.schedule", "ordinal": 0 }]
        },
        "target": { "kind": "run", "run": "akm index --full" },
        "env": { "MODE": "safe", "RETRIES": 3, "DRY_RUN": true },
        "akmTimeout": "5m",
        "akmRedact": ["CONTRACT_FIXTURE_TOKEN"]
      }
    }
  ]
}
