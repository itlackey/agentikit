        "file": "child-workflow/workflows/task-wrapped-child.yml",
        "ref": "workflows/task-wrapped-child",
        "expectedStepTargetKinds": { "dispatch": "child-workflow" },
        "expectedChildRefs": { "dispatch": "workflows/leaf" },
        "expectedChildDepth": 2
      },
      {
        "id": "exporter",
        "file": "child-workflow/workflows/exporter.md",
        "ref": "workflows/exporter",
